# Canonical site origin (e.g. https://scaleclub.criamosmomentum.com). Optional on Vercel, where the
# production domain is detected from VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=

# Upstash Redis (Vercel Marketplace) for distributed rate limiting of the form endpoints.
# Without them the endpoints fall back to per-instance in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Lead destinations (docs/integrations/leads.md). The forms answer 503 until all of them are set.
# Attio CRM: every lead becomes a person; meeting requests and applications also open a deal owned by this member.
ATTIO_API_TOKEN=
ATTIO_DEAL_OWNER_EMAIL=
# Brevo: e-book and newsletter leads join these lists; e-book leads also get the delivery template.
BREVO_API_TOKEN=
BREVO_EBOOK_LIST_ID=
BREVO_NEWSLETTER_LIST_ID=
BREVO_EBOOK_TEMPLATE_ID=

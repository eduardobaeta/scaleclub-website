# Dependencies
node_modules/

# Build output and generated files
dist/
.astro/
.vercel/
*.tsbuildinfo

# Tests
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Environment variables: only the example is versioned (`vercel env pull` writes .env.local)
.env*
!.env.example

# Credentials never enter git (docs/conventions.md §13)
credentials.json
credentials/
*.pem
*.key
*service-account*.json

# Logs and caches
*.log
.eslintcache

# Editors and OS: only project-wide editor settings are shared
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store

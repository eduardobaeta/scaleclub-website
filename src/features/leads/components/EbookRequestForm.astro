---
import Button from '@/components/ui/Button.astro';
import ConsentField from '@/components/ui/ConsentField.astro';
import TextField from '@/components/ui/TextField.astro';
import { ebookRequestForm } from '@/config/forms';
import LeadForm from './LeadForm.astro';

const { fields, submitLabel, messages } = ebookRequestForm;
---

<LeadForm type="ebook-request" statusId="ebook-status" messages={messages} class="flex flex-col gap-3">
  <TextField id="ebook-name" name="name" autocomplete="name" required minlength={2} maxlength={120} {...fields.name} />
  <TextField
    id="ebook-email"
    name="email"
    type="email"
    autocomplete="email"
    required
    maxlength={254}
    {...fields.email}
  />
  <TextField id="ebook-instagram" name="instagram" maxlength={60} {...fields.instagram} />
  <ConsentField id="ebook-consent" name="consent" {...fields.consent} />
  <Button type="submit" variant="solid" size="lg" block class="mt-1">
    {submitLabel}
  </Button>
</LeadForm>

---
import { footerContent, interfaceText, siteConfig } from '@/config/site';
import BrandLockup from './BrandLockup.astro';
---

<footer class="relative">
  <div class="container-site pt-12 pb-8 md:pt-16 lg:pt-20">
    <div class="grid gap-10 md:grid-cols-2 lg:gap-0">
      <div>
        <BrandLockup />
        <p class="type-body-sm mt-5 max-w-[23rem] text-muted-foreground">{footerContent.description}</p>
      </div>
      <div class="lg:max-w-[28.75rem] lg:justify-self-end lg:w-full">
        <p class="type-title text-foreground lg:type-body-lg lg:font-medium">{footerContent.newsletterTitle}</p>
        <div class="mt-4">
          <slot name="newsletter" />
        </div>
      </div>
    </div>

    <nav aria-label={interfaceText.footerNavigation} class="mt-12 flex gap-12 md:gap-16 lg:mt-16 lg:gap-24">
      <div>
        <p class="type-overline text-foreground">{footerContent.navigationTitle}</p>
        <ul class="mt-3.5 space-y-3.5">
          {footerContent.navigation.map((link) => (
            <li>
              <a href={link.href} class="type-body-sm text-muted-foreground transition-colors hover:text-foreground">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="type-overline text-foreground">{footerContent.contactTitle}</p>
        <ul class="mt-3.5 space-y-3.5">
          {footerContent.contacts.map((link) => (
            <li>
              <a
                href={link.href}
                class="type-body-sm break-all text-muted-foreground transition-colors hover:text-foreground"
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.label}
                {link.external && <span class="sr-only"> {interfaceText.opensInNewTab}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <div class="mt-12 flex flex-col gap-2 border-t border-border pt-6 md:flex-row md:items-center md:justify-between lg:mt-16">
      <p class="type-caption text-subtle-foreground">{footerContent.copyright}</p>
      <p class="type-caption font-medium tracking-[0.04em] text-primary">{siteConfig.tagline}</p>
    </div>
  </div>
</footer>

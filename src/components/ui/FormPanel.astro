---
interface Props {
  title: string;
  description: string;
  class?: string;
}

const { title, description, class: className } = Astro.props;
---

<div class:list={['rounded-panel bg-panel p-6 shadow-glow backdrop-blur-md md:p-8', className]}>
  <p class="type-card-title text-foreground">{title}</p>
  <p class="type-small mt-2 text-muted-foreground">{description}</p>
  <div class="mt-6">
    <slot />
  </div>
</div>

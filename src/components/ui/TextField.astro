---
import type { HTMLAttributes } from 'astro/types';
import FieldError from './FieldError.astro';

type Props = Omit<HTMLAttributes<'input'>, 'id' | 'name' | 'class'> & {
  id: string;
  label: string;
  name: string;
  hideLabel?: boolean;
  error?: string;
  class?: string;
};

const { id, label, name, hideLabel = false, error, class: className, type = 'text', ...inputAttributes } = Astro.props;
---

<div class:list={['flex flex-col gap-2', className]}>
  <label for={id} class:list={['type-label text-muted-foreground', hideLabel && 'sr-only']}>
    {label}
  </label>
  <input id={id} name={name} type={type} class="form-control" {...inputAttributes} />
  <FieldError id={id} message={error} />
</div>

---
import { CirclePlay } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import Pill from '@/components/ui/Pill.astro';
import YouTubeFacade from '@/components/ui/YouTubeFacade.astro';
import { lessonContent } from '@/config/content/double-diamond';

const { id, eyebrow, title, lead, action, video, afterVideo, afterVideoAction } = lessonContent;
---

<section id={id} class="container-site pt-32 pb-20 md:pt-40 lg:pt-50 lg:pb-35">
  <Pill data-reveal="fade">
    <CirclePlay slot="icon" class="size-4 text-primary" aria-hidden="true" />
    {eyebrow}
  </Pill>
  <h1 class="type-display mt-6 max-w-[48rem] text-foreground" data-reveal>
    {title}
  </h1>
  <p class="type-lead mt-6 max-w-copy text-soft-foreground" data-reveal>
    {lead}
  </p>
  <div class="mt-8" data-reveal>
    <Button href={action.href}>{action.label}</Button>
  </div>
  <div class="mt-12 shadow-glow lg:mt-16" data-reveal="fade">
    <YouTubeFacade videoId={video.id} title={video.title} poster={video.poster} playLabel={video.playLabel} />
  </div>
  <div class="mt-8 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
    <p class="type-body max-w-[29rem] text-soft-foreground">{afterVideo}</p>
    <Button href={afterVideoAction.href} class="self-start md:self-auto">
      {afterVideoAction.label}
    </Button>
  </div>
</section>

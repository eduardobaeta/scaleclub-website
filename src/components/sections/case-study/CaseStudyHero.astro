---
import { ArrowLeft } from '@lucide/astro';
import { caseStudyPage } from '@/config/content/case-studies';
import type { CaseStudy } from '@/lib/case-studies';
import CaseSurface from './CaseSurface.astro';

interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props;
const { tag, title, subtitle, intro, stats } = caseStudy.data;
const { back } = caseStudyPage;
---

<section class="container-site pt-28 md:pt-36">
  <a
    href={back.href}
    class="type-button inline-flex items-center gap-2 text-soft-foreground transition-colors hover:text-foreground"
  >
    <ArrowLeft class="size-4" aria-hidden="true" />
    {back.label}
  </a>

  <CaseSurface
    caseStudy={caseStudy}
    logoClass="h-5 md:h-6"
    class="mt-6 min-h-[26rem] rounded-3xl md:min-h-[32rem] lg:p-16"
    data-reveal="fade"
  >
    <div class="mt-auto pt-16">
      <p class="type-caption inline-block rounded-full bg-white/15 px-3 py-1.5 font-medium">{tag}</p>
      <h1 class="type-display mt-5 max-w-[56rem] text-balance">{title}</h1>
      <p class="type-lead mt-5 max-w-[44rem] text-white/80">{subtitle}</p>
    </div>
  </CaseSurface>

  <div class="mt-12 grid gap-10 md:mt-16 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
    <p class="type-lead text-foreground" data-reveal>
      {intro}
    </p>
    <ul class="grid gap-2 md:grid-cols-3" data-reveal>
      {stats.map((stat) => (
        <li class="flex flex-col justify-between gap-6 rounded-2xl bg-muted p-6">
          <span class="type-heading-md text-foreground">{stat.value}</span>
          <span class="type-small text-soft-foreground">{stat.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

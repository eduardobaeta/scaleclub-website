---
import { methodologyContent } from '@/config/content/home';

const { id, title, description, steps } = methodologyContent;

const barClasses = [
  'bg-step-1 max-md:w-1/2 md:h-35',
  'bg-step-2 max-md:w-3/5 md:h-42',
  'bg-step-3 max-md:w-7/10 md:h-49',
  'bg-step-4 max-md:w-4/5 md:h-56',
  'bg-step-5 max-md:w-9/10 md:h-63',
  'bg-step-6 max-md:w-full md:h-70',
];
const offsetClasses = ['md:mt-35', 'md:mt-28', 'md:mt-21', 'md:mt-14', 'md:mt-7', 'md:mt-0'];
---

<section id={id} class="relative" data-scroll-steps>
  <div class="sticky top-0 flex h-svh flex-col overflow-hidden">
    <div class="container-site flex flex-1 flex-col justify-center gap-6 md:justify-between md:pt-30 md:pb-16">
      <div class="mx-auto max-w-[45.75rem] text-center">
        <h2 class="type-heading-lg text-foreground">{title}</h2>
        <p class="type-subtitle mx-auto mt-3 max-w-[38rem] text-soft-foreground">{description}</p>
      </div>
      <ol class="flex flex-col gap-4 md:grid md:grid-cols-6 md:items-end md:gap-5">
        {steps.map((step, index) => (
          <li
            class="group/step transition-opacity duration-500 data-[state=hidden]:opacity-0"
            data-step-item
            data-state="done"
          >
            <div
              class:list={[
                'transition-opacity duration-500 group-data-[state=current]/step:opacity-50 md:pl-4',
                offsetClasses[index],
              ]}
            >
              <p class="flex items-baseline gap-2 md:block">
                <span class="type-label text-primary md:type-index">{step.index}</span>
                <span class="type-step-title block text-foreground md:mt-2">{step.title}</span>
              </p>
              <p class="type-step-copy mt-1.5 text-soft-foreground md:mt-2 md:max-w-40">{step.description}</p>
            </div>
            <div
              class:list={[
                'mt-3 h-2.5 origin-left rounded-full transition duration-700 ease-(--easing-standard) group-data-[state=current]/step:opacity-45 group-data-[state=hidden]/step:scale-x-0 md:mt-4 md:w-full md:origin-bottom md:rounded-none md:rounded-tl-full md:group-data-[state=hidden]/step:scale-x-100 md:group-data-[state=hidden]/step:scale-y-0',
                barClasses[index],
              ]}
              aria-hidden="true"
            />
          </li>
        ))}
      </ol>
    </div>
  </div>
  {steps.map(() => (
    <div class="h-67.5 md:h-112.5" data-step-trigger aria-hidden="true" />
  ))}
  <div class="h-67.5 md:h-112.5" data-step-trigger aria-hidden="true"></div>
  <div class="h-45 md:h-67.5" aria-hidden="true"></div>
</section>

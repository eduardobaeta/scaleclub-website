---
import Section from '@/components/layout/Section.astro';
import FormPanel from '@/components/ui/FormPanel.astro';
import StepList from '@/components/ui/StepList.astro';
import { application } from '@/config/content/table-page';
import { MentoringApplicationForm } from '@/features/leads';

const { id, title, lead, steps, form } = application;
---

<Section id={id}>
  <div class="grid gap-12 lg:grid-cols-[1fr_27.625rem] lg:gap-20">
    <div>
      <h2 class="type-heading-sm max-w-[32rem] text-foreground" data-reveal>
        {title}
      </h2>
      <p class="type-body mt-4 max-w-[35rem] text-soft-foreground" data-reveal>
        {lead}
      </p>
      <div class="mt-10">
        <StepList steps={steps} />
      </div>
    </div>
    <FormPanel title={form.title} description={form.description}>
      <MentoringApplicationForm />
    </FormPanel>
  </div>
</Section>

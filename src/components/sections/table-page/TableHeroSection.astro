---
import { CalendarDays } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import HighlightTitle from '@/components/ui/HighlightTitle.astro';
import Pill from '@/components/ui/Pill.astro';
import { tableHero } from '@/config/content/table-page';

const { eyebrow, title, lead, action, actionNote, stats } = tableHero;
---

<section class="container-site pt-32 pb-20 md:pt-40 lg:pt-50 lg:pb-40">
  <Pill data-reveal="fade">
    <CalendarDays slot="icon" class="size-4 text-primary" aria-hidden="true" />
    {eyebrow}
  </Pill>
  <HighlightTitle as="h1" parts={title} breakBeforeHighlight class="type-display-xl mt-6 text-foreground" data-reveal />
  <p class="type-lead mt-8 max-w-copy text-soft-foreground" data-reveal>
    {lead}
  </p>
  <div class="mt-8" data-reveal>
    <Button href={action.href}>{action.label}</Button>
  </div>
  <p class="type-small mt-3 text-muted-foreground" data-reveal>
    {actionNote}
  </p>
  <dl class="mt-14 grid grid-cols-2 gap-2 lg:mt-16 lg:grid-cols-4">
    {stats.map((stat) => (
      <div class="flex flex-col rounded-2xl bg-card p-5 md:p-7" data-reveal>
        <dt class="type-stat text-primary">{stat.value}</dt>
        <dd class="type-body-sm mt-8 text-muted-foreground md:mt-12">{stat.label}</dd>
      </div>
    ))}
  </dl>
</section>
